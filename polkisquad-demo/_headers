# Cloudflare Pages _headers file
# Applied to all routes. Modifies HTTP response headers.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# Default security + performance headers for all paths
/*
  # Force HTTPS for at least 1 year, including subdomains, allow preload
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Prevent MIME-type sniffing
  X-Content-Type-Options: nosniff

  # Don't allow framing from other origins (clickjacking protection)
  X-Frame-Options: SAMEORIGIN

  # Strict referrer policy
  Referrer-Policy: strict-origin-when-cross-origin

  # Disable dangerous browser features
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

  # Cross-origin isolation
  # NOTE: COEP require-corp breaks iframes (OSM map, IG embed, Bancard/Tigo widgets)
  # unless they send Cross-Origin-Resource-Policy: cross-origin
  # Removed to allow planned donation integrations.
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

  # Caching for static assets (default — overridden by specific rules below)
  Cache-Control: public, max-age=300, must-revalidate

  # Content Security Policy
  # Note: Single directive per header. Each rule category listed ONCE.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://plausible.io https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://plausible.io https://static.cloudflareinsights.com; frame-src 'self' https://www.openstreetmap.org; object-src 'none'; base-uri 'self'

# Cache static assets aggressively (filename-versioned in production would be better)
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=86400

/og/*
  Cache-Control: public, max-age=86400

# Sitemap — moderate cache (so updates reflect within an hour)
/sitemap.xml
  Cache-Control: public, max-age=3600, must-revalidate

# Security.txt (RFC 9116)
/.well-known/security.txt
  Content-Type: text/plain

# Note on duplicate headers:
# _headers file does NOT support having the same header twice with different values.
# When a conflict exists, Cloudflare uses the first occurrence.
# So this file is now strict — one CSP, one Cache-Control per path.