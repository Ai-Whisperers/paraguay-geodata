# Cloudflare Pages _headers file
# Applied to all routes. Modifies HTTP response headers.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# Default security + performance headers for all paths
/*
  # Force HTTPS for at least 1 year, including subdomains, allow preload
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Prevent MIME-type sniffing
  X-Content-Type-Options: nosniff

  # Don't allow framing from other origins (clickjacking protection)
  X-Frame-Options: SAMEORIGIN

  # Strict referrer policy
  Referrer-Policy: strict-origin-when-cross-origin

  # Disable dangerous browser features
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

  # Cross-origin isolation
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

  # Caching for static assets
  Cache-Control: public, max-age=300, must-revalidate

  # Allowed content sources (CSP)
  # Note: this is a starting point. Adjust as needed.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://plausible.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' https://plausible.io; frame-src 'self' https://www.openstreetmap.org; object-src 'none'; base-uri 'self'

# Cache static assets aggressively
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400

/og/*
  Cache-Control: public, max-age=86400

# Don't cache sitemap aggressively (so updates reflect quickly)
  Cache-Control: public, max-age=3600

# Security.txt (RFC 9116)
/.well-known/security.txt
  Content-Type: text/plain
