# Secrets — set via `wrangler secret put <NAME>` for production deploys.
# The values below are TEST-mode IDs created during initial setup (2026-07-14).
# For live mode, create real products + prices in the Stripe dashboard and replace.

# Required
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_LIVE_KEY
DOWNLOAD_TOKEN_SIGNING_KEY=CHANGE_ME_random_32_byte_hex

# Price IDs (created in test mode; replace with live IDs before going live)
STRIPE_PRICE_GEOJSON_ONE_TIME=price_1TxwVCKHq6GxbJ56JeS6bliT
STRIPE_PRICE_DXF_ONE_TIME=price_1TxwVUKHq6GxbJ56CF3h2bcP
STRIPE_PRICE_SUB_YEARLY=price_1TxwVUKHq6GxbJ56KxMar2Yc

# Optional: dataset base URL (if not using R2 binding). Should be a Cloudflare R2
# public bucket or Pages deploy serving the full national GeoJSON/DXF.
DATASET_BASE_URL=https://geodata-exports.r2.dev

# Optional: custom domain for the success page redirect (defaults to request origin).
# PUBLIC_DOWNLOAD_BASE_URL=https://geodata.paragu-ai.com