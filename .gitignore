# Big/raw files we don't ship (we keep *latest* in exports/web/data/)
data/properties/cache/
data/properties/snapshots/

# 7,912 tile metadata files (legacy fetch output, 63 MB).  Source-of-truth
# is the canonical tile_index.json in exports/web/data/.  Regenerate with
# `python3 -m tools.national_tile_index` if needed.
data/tiles/

# 48 MB of half-scraped URLs that should have been in cache from day one.
data/properties/clasipar_urls.json

# 4.3 MB raw TuLugar snapshot (gitignored but loose on disk).
data/properties/tulugar_snap.json

# Parquet analytics exports (regenerated by canonicalize).
data/properties/*.parquet

# Tile seed data (regenerated by fetch_ine_admin + extract_geofabrik).
data/tiles_seed/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage / local
.coverage
coverage.json
*.log

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# Local
.env
.env.local
node_modules/

# Wrangler (Cloudflare) local state
.wrangler/

# Tiles / rasters we may eventually fetch (very large)
*.dem.tif
*.tiff
*.tif

# Big raw Geofabrik / OSM PBF downloads
*.osm.pbf
*.shp.zip
*.gpkg.zip

