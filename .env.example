# Paraguay Geodata — environment variables
# Copy to `.env` and fill in.  NEVER commit `.env`.

# ----------------------------------------------------------------------------
# Cloudflare Pages deployment (REQUIRED for `make deploy-prod`)
# ----------------------------------------------------------------------------
# Primary account (production + main branch)
CLOUDFLARE_API_TOKEN=replace_me_with_a_Wrangler_token
CLOUDFLARE_ACCOUNT_ID=replace_me_with_account_id

# Secondary account (DR + staging branch) — optional
CLOUDFLARE_API_TOKEN_BACKUP=
CLOUDFLARE_ACCOUNT_ID_BACKUP=

# Project + branch
CF_PAGES_PROJECT_NAME=paraguay-geodata
CF_PAGES_BRANCH=main

# ----------------------------------------------------------------------------
# R2 / S3 mirror (optional, for daily backup of the canonical geojson)
# ----------------------------------------------------------------------------
R2_ENDPOINT_URL=https://replace_me.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=paraguay-geodata-mirror

# ----------------------------------------------------------------------------
# Source-portal auth (optional, for headless renderings)
# ----------------------------------------------------------------------------
INFOCASAS_PROXY_ROTATION=
TULUGAR_API_KEY=

# ----------------------------------------------------------------------------
# Monitoring (optional)
# ----------------------------------------------------------------------------
SENTRY_DSN=
UPTIMEROBOT_API_KEY=
PLAUSIBLE_DOMAIN=geodata.paragu-ai.com
LIGHTHOUSE_API_TOKEN=

# ----------------------------------------------------------------------------
# Stripe (planned, not yet active)
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# Cron behavior
# ----------------------------------------------------------------------------
PY_REFRESH_LOG_LEVEL=INFO
PY_REFRESH_DRY_RUN=false
PY_REFRESH_MAX_PARALLEL=4
PY_REFRESH_TIMEOUT_SEC=3600
